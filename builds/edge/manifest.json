{
  "manifest_version": 3,
  "name": "WhatsApp Sender",
  "version": "1.6.1",
  "description": "Local opt-in WhatsApp Web text queue, CSV import, progress and reporting.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}